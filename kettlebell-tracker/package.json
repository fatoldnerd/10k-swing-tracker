{
  "name": "kettlebell-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "export": "next build",
    "deploy": "npm run build && firebase deploy --only hosting --project k-swing-challenge-tracker",
    "firebase:emulators": "firebase emulators:start",
    "firebase:deploy": "firebase deploy",
    "type-check": "tsc --noEmit",
    "test:emulators": "echo 'Start emulators: npm run firebase:emulators (in another terminal)' && npm run dev",
    "test:build": "npm run type-check && npm run lint && npm run build",
    "test:production": "npm run build && npm run start",
    "firebase:rules": "firebase deploy --only firestore:rules",
    "setup:env": "cp .env.local.example .env.local && echo 'Please edit .env.local with your Firebase credentials'"
  },
  "dependencies": {
    "@firebase/app": "^0.13.1",
    "@firebase/firestore": "^4.7.17",
    "@hookform/resolvers": "^5.1.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^11.9.1",
    "lucide-react": "^0.518.0",
    "next": "15.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.58.1",
    "recharts": "^2.15.3",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5"
  }
}
