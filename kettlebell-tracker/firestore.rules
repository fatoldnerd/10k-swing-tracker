rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User-specific security rules for authenticated users
    
    // Workouts: Users can only access their own workouts
    match /workouts/{workoutId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Workout rounds: Users can only access rounds for their own workouts
    match /workout_rounds/{roundId} {
      allow read, delete: if request.auth != null && 
        exists(/databases/$(database)/documents/workouts/$(resource.data.workoutId)) &&
        get(/databases/$(database)/documents/workouts/$(resource.data.workoutId)).data.userId == request.auth.uid;
      allow update: if request.auth != null &&
        request.resource.data.workoutId == resource.data.workoutId &&
        get(/databases/$(database)/documents/workouts/$(resource.data.workoutId)).data.userId == request.auth.uid;
      allow create: if request.auth != null &&
        exists(/databases/$(database)/documents/workouts/$(request.resource.data.workoutId)) &&
        get(/databases/$(database)/documents/workouts/$(request.resource.data.workoutId)).data.userId == request.auth.uid;
    }
    
    // User settings: Users can only access their own settings
    match /user_settings/{settingsId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Challenges: Users can only access their own challenges
    match /challenges/{challengeId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Achievements: Users can only access their own achievements
    match /achievements/{achievementId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}