<svg width="180" height="180" viewBox="0 0 180 180" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="apple-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f97316"/>
      <stop offset="100%" style="stop-color:#dc2626"/>
    </linearGradient>
  </defs>
  
  <!-- Rounded background for iOS -->
  <rect width="180" height="180" rx="40" fill="#1f2937"/>
  
  <!-- Kettlebell Body -->
  <circle cx="90" cy="115" r="40" fill="url(#apple-gradient)"/>
  
  <!-- Handle -->
  <path d="M65 65 C65 55, 75 45, 90 45 C105 45, 115 55, 115 65 L115 90 C115 100, 105 100, 90 100 C75 100, 65 100, 65 90 Z" 
        fill="none" 
        stroke="url(#apple-gradient)" 
        stroke-width="10" 
        stroke-linecap="round"/>
        
  <!-- Handle grip details -->
  <line x1="80" y1="70" x2="80" y2="85" stroke="url(#apple-gradient)" stroke-width="3" opacity="0.8"/>
  <line x1="90" y1="70" x2="90" y2="85" stroke="url(#apple-gradient)" stroke-width="3" opacity="0.8"/>
  <line x1="100" y1="70" x2="100" y2="85" stroke="url(#apple-gradient)" stroke-width="3" opacity="0.8"/>
</svg>